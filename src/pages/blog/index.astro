---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.pubDate.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
---
<Base title="Blog | Taleeb Midi">
  <div class="wrap">
    <h1 class="page-title">All posts</h1>
    {[...byYear.entries()].map(([year, yearPosts]) => (
      <>
        <h2 class="year">{year}</h2>
        <ul class="posts">
          {yearPosts.map((post) => (
            <li>
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                {post.data.pubDate.toISOString().slice(0, 10)}
              </time>
              <a href={`/blog/${post.data.slug || post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</Base>