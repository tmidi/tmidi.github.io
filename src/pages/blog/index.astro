---
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts, isoDate, postUrl, type Post } from '../../lib/posts';

const byYear = new Map<number, Post[]>();
for (const post of await getPublishedPosts()) {
  const year = post.data.pubDate.getUTCFullYear();
  const bucket = byYear.get(year) ?? [];
  bucket.push(post);
  byYear.set(year, bucket);
}
---
<Base title={`Blog | ${SITE_TITLE}`}>
  <div class="wrap">
    <h1 class="page-title">All posts</h1>
    {[...byYear.entries()].map(([year, yearPosts]) => (
      <>
        <h2 class="year">{year}</h2>
        <ul class="posts">
          {yearPosts.map((post) => (
            <li>
              <time datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time>
              <a href={postUrl(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</Base>