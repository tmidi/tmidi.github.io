---
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts, tagSlug, tagUrl } from '../../lib/posts';

const bySlug = new Map<string, string>();
for (const post of await getPublishedPosts()) {
  for (const tag of post.data.tags) {
    if (!bySlug.has(tagSlug(tag))) bySlug.set(tagSlug(tag), tag);
  }
}
const tags = [...bySlug.values()].sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));
---
<Base title={`Tags | ${SITE_TITLE}`}>
  <div class="wrap">
    <h1 class="page-title">Tags</h1>
    <div class="tag-cloud">
      {tags.map((tag) => (
        <a href={tagUrl(tag)}>
          #{tag}
        </a>
      ))}
    </div>
  </div>
</Base>