---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const post of posts) for (const t of post.data.tags) tags.add(t);
  return [...tags].map((tag) => ({
    params: { tag: tag.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.data.tags.some((t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-') === Astro.params.tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title={`#${tag} | Taleeb Midi`}>
  <div class="wrap">
    <h1 class="page-title">#{tag}</h1>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <a href={`/blog/${post.data.slug || post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>