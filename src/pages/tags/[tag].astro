---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts, isoDate, postUrl, tagSlug, type Post } from '../../lib/posts';

export const getStaticPaths = (async () => {
  // Keyed by slug so tags differing only in case/punctuation share one page.
  const byTag = new Map<string, { tag: string; posts: Post[] }>();
  for (const post of await getPublishedPosts()) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      const entry = byTag.get(slug) ?? { tag, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }
  return [...byTag].map(([slug, props]) => ({ params: { tag: slug }, props }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, posts } = Astro.props;
---
<Base title={`#${tag} | ${SITE_TITLE}`}>
  <div class="wrap">
    <h1 class="page-title">#{tag}</h1>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time>
          <a href={postUrl(post)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>