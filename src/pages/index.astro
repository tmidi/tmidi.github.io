---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, isoDate, postUrl } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---
<Base>
  <section class="hero wrap">
    <h1>Director of DevOps.</h1>
    <p>
      I'm Taleeb Midi — I lead platform and infrastructure teams, and I write about
      DevOps, Linux, and the practices that make teams ship reliably.
    </p>
    <a class="cta" href="/blog/">Read the blog →</a>
  </section>

  <section class="wrap">
    <h2 class="section">Recent posts</h2>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={isoDate(post.data.pubDate)}>{isoDate(post.data.pubDate)}</time>
          <a href={postUrl(post)}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>