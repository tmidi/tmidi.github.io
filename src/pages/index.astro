---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---
<Base>
  <section class="hero wrap">
    <h1>Director of DevOps.</h1>
    <p>
      I'm Taleeb Midi — I lead platform and infrastructure teams, and I write about
      DevOps, Linux, and the practices that make teams ship reliably.
    </p>
    <a class="cta" href="/blog/">Read the blog →</a>
  </section>

  <section class="wrap">
    <h2 class="section">Recent posts</h2>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <a href={`/blog/${post.data.slug || post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>